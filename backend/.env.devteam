PORT=8080
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=devteam_hub

# Auth 
JWT_ACCESS_SECRET=devteam-hub-access-secret-change-me-in-production
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=30

# Cookies: set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
NODE_ENV=development

# CORS allowlist (comma-separated). Frontend origins only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Brute-force limits
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20
REFRESH_RATE_WINDOW_MS=900000
REFRESH_RATE_MAX=60
